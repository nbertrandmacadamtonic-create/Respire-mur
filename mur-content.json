
/* M.U.R. — Extensions sans modifier index.html
   - Video automatique sans son
   - Bouton Commencer a la fin
   - Appui long sur logo : back-office
   - Gestion des contenus
*/

(() => {
  'use strict';

  const VIDEO =
    'Logo_character_comes_to_life_20261031152523.mp4';

  // 1. VIDEO D'ACCUEIL
  function intro() {
    const panel =
      document.getElementById('presentation');

    const video =
      document.getElementById('murIntroVideo');

    if (!panel || !video || panel.dataset.murIntroV2) {
      return;
    }

    panel.dataset.murIntroV2 = '1';

    // Un seul lecteur, celui de index.html
    video.muted = true;
    video.autoplay = true;
    video.playsInline = true;
    video.preload = 'auto';
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');

    // Retirer les anciens boutons
    panel.querySelectorAll(
      '.mur-intro-skip,' +
      '.mur-video-skip,' +
      '.mur-sound-start,' +
      '.mur-commencer'
    ).forEach(el => el.remove());

    // BOUTON COMMENCER
    const commencer = document.createElement('button');

    commencer.type = 'button';
    commencer.className = 'mur-commencer';
    commencer.textContent = 'Commencer';

    commencer.style.cssText = `
      position: absolute;
      left: 50%;
      bottom: calc(58px + env(safe-area-inset-bottom));
      transform: translateX(-50%);
      z-index: 100;
      display: none;
      min-width: 190px;
      min-height: 54px;
      padding: 14px 28px;
      border: 1px solid rgba(255,255,255,.65);
      border-radius: 999px;
      background: #ffffff;
      color: #07111f;
      font: 900 17px system-ui, sans-serif;
      box-shadow: 0 0 30px rgba(255,255,255,.24);
      cursor: pointer;
    `;

    panel.appendChild(commencer);

    // Afficher Commencer sur la derniere image
    function showCommencer() {
      video.pause();
      commencer.style.display = 'block';
      panel.classList.remove('hide');
    }

    // Lecture automatique de la video
    function startIntro() {
      panel.classList.remove('hide');
      commencer.style.display = 'none';

      video.pause();
      video.muted = true;

      try {
        video.currentTime = 0;
      } catch (e) {}

      const playback = video.play();

      if (playback && playback.catch) {
        playback.catch(showCommencer);
      }
    }

    // Intercepter la fin AVANT l'ancien gestionnaire
    // qui envoyait automatiquement vers l'accueil
    video.addEventListener('ended', e => {
      e.stopImmediatePropagation();
      showCommencer();
    }, true);

    video.addEventListener('error', e => {
      e.stopImmediatePropagation();
      showCommencer();
    }, true);

    // Entrer dans l'application uniquement sur clic
    commencer.addEventListener('click', () => {
      if (typeof window.enterApp === 'function') {
        window.enterApp();
      } else {
        panel.classList.add('hide');
      }

      if (typeof window.showPage === 'function') {
        window.showPage('home');
      }
    });

    // Appui court sur logo : revoir introduction
    window.openPresentation = startIntro;

    // Lancement initial
    startIntro();
  }

  // 2. CHARGEMENT DU CONTENU DU BACK-OFFICE
  async function applyContent() {
    try {
      const resp = await fetch(
        'mur-content.json',
        { cache: 'no-store' }
      );

      if (!resp.ok) {
        throw new Error('Fichier contenu absent');
      }

      const data = await resp.json();

      // Questions ki.S
      if (
        Array.isArray(data.questions) &&
        data.questions.length === 15 &&
        typeof KIS_QUESTIONS !== 'undefined'
      ) {
        const valid = data.questions.every(q =>
          ['text', 'a', 'f', 'p'].every(k =>
            typeof q[k] === 'string' && q[k].trim()
          )
        );

        if (valid) {
          KIS_QUESTIONS.splice(
            0,
            KIS_QUESTIONS.length,
            ...data.questions.map(q => ({ ...q }))
          );
        }
      }

      // Exercices
      if (
        data.exercises &&
        typeof EXERCISES !== 'undefined'
      ) {
        Object.keys(EXERCISES).forEach(k => {
          const v = data.exercises[k];
          if (!v || typeof v.title !== 'string') return;

          ['title', 'caption'].forEach(prop => {
            if (typeof v[prop] === 'string') {
              EXERCISES[k][prop] = v[prop];
            }
          });

          ['files', 'sounds', 'why'].forEach(prop => {
            if (Array.isArray(v[prop])) {
              EXERCISES[k][prop] = v[prop].filter(
                x => typeof x === 'string'
              );
            }
          });
        });
      }

      // Respirations
      if (
        data.breaths &&
        typeof BREATHS !== 'undefined'
      ) {
        Object.keys(BREATHS).forEach(k => {
          const v = data.breaths[k];
          if (!v) return;

          ['i', 'hi', 'e', 'ho', 'duration'].forEach(p => {
            if (
              Number.isFinite(v[p]) &&
              v[p] >= 0
            ) {
              BREATHS[k][p] = v[p];
            }
          });

          if (typeof v.msg === 'string') {
            BREATHS[k].msg = v.msg;
          }
        });
      }

      window.dispatchEvent(
        new Event('mur-content-loaded')
      );

    } catch (e) {
      console.info(
        'M.U.R. : contenu par defaut conserve',
        e.message
      );
    }
  }

  // 3. APPUI LONG SUR LOGO : BACK-OFFICE
  function installAdminLongPress() {
    const brand =
      document.querySelector('.top .brand');

    if (!brand || brand.dataset.murAdminLongPress) {
      return;
    }

    brand.dataset.murAdminLongPress = '1';

    let timer = null;
    let longTriggered = false;
    let pointerStart = null;

    const clear = () => {
      if (timer !== null) {
        clearTimeout(timer);
        timer = null;
      }
    };

    brand.addEventListener('pointerdown', e => {
      if (e.button !== 0 || !e.isPrimary) return;

      clear();
      longTriggered = false;

      pointerStart = {
        x: e.clientX,
        y: e.clientY
      };

      timer = setTimeout(() => {
        timer = null;
        longTriggered = true;

        if (navigator.vibrate) {
          navigator.vibrate(40);
        }

        window.location.href = 'admin.html';
      }, 2000);
    });

    brand.addEventListener('pointermove', e => {
      if (
        pointerStart &&
        Math.hypot(
          e.clientX - pointerStart.x,
          e.clientY - pointerStart.y
        ) > 14
      ) {
        clear();
      }
    });

    [
      'pointerup',
      'pointercancel',
      'pointerleave'
    ].forEach(name => {
      brand.addEventListener(name, () => {
        clear();
        pointerStart = null;
      });
    });

    brand.addEventListener('click', e => {
      if (!longTriggered) return;

      e.preventDefault();
      e.stopImmediatePropagation();
      longTriggered = false;
    }, true);

    brand.addEventListener('contextmenu', e => {
      if (timer !== null || longTriggered) {
        e.preventDefault();
      }
    });
  }

  // 4. INITIALISATION
  function init() {
    intro();
    applyContent();
    installAdminLongPress();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
